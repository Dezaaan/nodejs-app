{
  "name": "nodejs-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "db:create-migration": "node-pg-migrate create -m database/migrations",
    "db:migrate": "node-pg-migrate --env-file=.env up -m database/migrations",
    "db:migrate:test": "node --env-file=.env.test ./node_modules/node-pg-migrate/bin/node-pg-migrate up -m database/migrations",
    "db:rollback": "node-pg-migrate --env-file=.env down -m database/migrations",
    "dev": "tsx watch src/index.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "node --env-file=.env.test ./node_modules/vitest/vitest.mjs run tests/integration",
    "test:api": "node --env-file=.env.test ./node_modules/vitest/vitest.mjs run tests/api",
    "test:all": "node --env-file=.env.test ./node_modules/vitest/vitest.mjs run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "node-pg-migrate": "^9.0.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
